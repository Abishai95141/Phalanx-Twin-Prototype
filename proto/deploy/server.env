# Sourced on the server (bash). One conda env for both sides; the data layer is put on PYTHONPATH only by
# proto/runner/run.sh, so the ground side still cannot import it.
export PHX_HOME=$HOME/phalanx
export PHX_REPO=$PHX_HOME/Phalanx-Solution
export PHX_DATALAYER_CODE=$PHX_HOME/phalanx_data_layer_preview/code
# Parquet is unreliable on big-endian IBM Z: the ground side and the go/no-go read the preview's IPC copy
# (proto/deploy/preview_to_ipc.py) and runs are written as Arrow IPC (proto/runner/ipcstore.py).
export PHX_PREVIEW_FLEET=$PHX_HOME/phalanx_data_layer_preview/data/v0.9/fleet_ipc
export PHX_PREVIEW_FLEET_IPC=$PHX_PREVIEW_FLEET
export PHX_STORE_FORMAT=arrow
export PHX_PY=$HOME/envs/phx/bin/python
export PHX_NUMBA_SHIM=1          # no numba build exists for s390x: pure-Python kernels (see runner/numba_shim)
export PATH=$HOME/envs/phx/bin:$HOME/.cargo/bin:$PATH
export PHX_RUN_DIR=${PHX_RUN_DIR:-$PHX_REPO/proto/runs/live}   # the run the API serves
export PHX_RUNNER_URL=http://127.0.0.1:8710
