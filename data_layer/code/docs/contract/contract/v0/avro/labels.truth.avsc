{
  "type": "record",
  "name": "labels_truth",
  "namespace": "phalanx.contract.v0",
  "doc": "RESTRICTED. Truth for validation and scoring only: truth values behind CIR samples, hidden health states per serial, the fault schedule and the data-quality defect manifest. Never part of the downstream contract view (invariant I5); consumer readers refuse this topic.",
  "fields": [
    {
      "name": "record_id",
      "type": {
        "type": "fixed",
        "name": "RecordId",
        "size": 16
      },
      "doc": "Idempotency key; blake2b-128 of the topic's record_id_key components (see record_id rules).",
      "phalanx.basis": "ARCH §12",
      "phalanx.restricted": false
    },
    {
      "name": "dict_version",
      "type": "string",
      "doc": "Parameter-dictionary semantic version (M01) the record was produced against.",
      "phalanx.basis": "ARCH §12",
      "phalanx.restricted": false
    },
    {
      "name": "dict_hash",
      "type": "string",
      "doc": "Parameter-dictionary content hash, lower-case hex (M01). Appears on every record.",
      "phalanx.basis": "ARCH §12",
      "phalanx.restricted": false
    },
    {
      "name": "label_kind",
      "type": {
        "type": "enum",
        "name": "LabelKind",
        "doc": "Kind of restricted truth label.",
        "symbols": [
          "TRUTH_SAMPLE",
          "HIDDEN_STATE",
          "FAULT",
          "DEFECT"
        ]
      },
      "doc": "Kind of label.",
      "phalanx.basis": "ARCH §12; ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    },
    {
      "name": "subject_id",
      "type": "string",
      "doc": "param_id (TRUTH_SAMPLE), hidden-state id (HIDDEN_STATE, from not_measured_states.csv), fault id (FAULT) or defect id (DEFECT).",
      "phalanx.basis": "ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    },
    {
      "name": "tail_no",
      "type": [
        "null",
        "string"
      ],
      "doc": "Tail the label belongs to.",
      "default": null,
      "phalanx.basis": "ARCH §5.3",
      "phalanx.restricted": false
    },
    {
      "name": "sortie_id",
      "type": [
        "null",
        "string"
      ],
      "doc": "Sortie the label belongs to, if any.",
      "default": null,
      "phalanx.basis": "ARCH §5.3",
      "phalanx.restricted": false
    },
    {
      "name": "serial_no",
      "type": [
        "null",
        "string"
      ],
      "doc": "Serial of the component or engine the label belongs to, if any.",
      "default": null,
      "phalanx.basis": "ARCH §5.3, §9.1 (hidden state per serial)",
      "phalanx.restricted": false
    },
    {
      "name": "t_true",
      "type": "long",
      "doc": "Physics time the label refers to (start time for faults and defects). The event time of the record.",
      "phalanx.basis": "ARCH §8 (t_true only in CIR and labels)",
      "phalanx.restricted": false,
      "phalanx.time_unit": "ns",
      "phalanx.time_scale": "sim_utc"
    },
    {
      "name": "t_end",
      "type": [
        "null",
        "long"
      ],
      "doc": "End time for faults or defects with a duration.",
      "default": null,
      "phalanx.basis": "ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false,
      "phalanx.time_unit": "ns",
      "phalanx.time_scale": "sim_utc"
    },
    {
      "name": "value",
      "type": [
        "null",
        "double"
      ],
      "doc": "Truth value (TRUTH_SAMPLE, HIDDEN_STATE) or fault severity, in `units`.",
      "default": null,
      "phalanx.basis": "ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    },
    {
      "name": "units",
      "type": [
        "null",
        "string"
      ],
      "doc": "Unit of value.",
      "default": null,
      "phalanx.basis": "ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    },
    {
      "name": "category",
      "type": [
        "null",
        "string"
      ],
      "doc": "Fault mode, defect type or observability class.",
      "default": null,
      "phalanx.basis": "ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    },
    {
      "name": "related_record_id",
      "type": [
        "null",
        "phalanx.contract.v0.RecordId"
      ],
      "doc": "Contract record this label refers to (the sample behind a TRUTH_SAMPLE, the defected record of a DEFECT).",
      "default": null,
      "phalanx.basis": "ARCH §10 (defect manifest); ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    },
    {
      "name": "source_module",
      "type": "string",
      "doc": "Module that produced the label (e.g. M10, M11, M13, M18).",
      "phalanx.basis": "ASSUMPTION: A-W0.4-16",
      "phalanx.restricted": false
    }
  ],
  "phalanx.contract_version": "0.2.0",
  "phalanx.contract_hash": "a4396f1d5482ce7816354ed7c9b040179d3c1467a7ca6e75b21fd71e1a904566",
  "phalanx.topic": "labels.truth",
  "phalanx.restricted": true
}
