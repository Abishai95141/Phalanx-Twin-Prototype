{
  "type": "record",
  "name": "maint_records",
  "namespace": "phalanx.contract.v0",
  "doc": "The §10 record types in one topic, discriminated by record_type, with linkage keys (tail, sortie, job number, component triplet, demand number, engine serial, sw_config_id, telemetry record_id). Each status change of a record is a new record version. Codes are synthetic IAF-relabelled tables (AD-19). Data-quality defects are injected after truth and listed only in labels.truth.",
  "fields": [
    {
      "name": "record_id",
      "type": {
        "type": "fixed",
        "name": "RecordId",
        "size": 16
      },
      "doc": "Idempotency key; blake2b-128 of the topic's record_id_key components (see record_id rules).",
      "phalanx.basis": "ARCH §12",
      "phalanx.restricted": false
    },
    {
      "name": "dict_version",
      "type": "string",
      "doc": "Parameter-dictionary semantic version (M01) the record was produced against.",
      "phalanx.basis": "ARCH §12",
      "phalanx.restricted": false
    },
    {
      "name": "dict_hash",
      "type": "string",
      "doc": "Parameter-dictionary content hash, lower-case hex (M01). Appears on every record.",
      "phalanx.basis": "ARCH §12",
      "phalanx.restricted": false
    },
    {
      "name": "record_type",
      "type": {
        "type": "enum",
        "name": "MaintRecordType",
        "doc": "The §10 record types.",
        "symbols": [
          "SORTIE",
          "TECH_LOG",
          "DEFECT_WO",
          "COMPONENT_LIFE",
          "INSPECTION",
          "SUPPLY_DEMAND",
          "CANNIBALISATION",
          "MODIFICATION",
          "EXCEEDANCE_INSPECTION",
          "SHOP_FINDING",
          "AVAILABILITY_STATE"
        ]
      },
      "doc": "Record type.",
      "phalanx.basis": "ARCH §10",
      "phalanx.restricted": false
    },
    {
      "name": "record_key",
      "type": "string",
      "doc": "Natural identity of the record across its versions (job number, demand number, or a synthetic key for logs and bins).",
      "phalanx.basis": "ASSUMPTION: A-W0.4-13",
      "phalanx.restricted": false
    },
    {
      "name": "record_version",
      "type": "long",
      "doc": "Version of the record; a new version is emitted at every status change.",
      "phalanx.basis": "ASSUMPTION: A-W0.4-13",
      "phalanx.restricted": false
    },
    {
      "name": "status",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "MaintStatus",
          "doc": "Lifecycle state of a maintenance record version.",
