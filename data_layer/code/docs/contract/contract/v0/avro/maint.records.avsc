            "OPEN",
            "IN_WORK",
            "AWAITING_PARTS",
            "AWAITING_MAINTENANCE",
            "DEFERRED",
            "CLOSED"
          ]
        }
      ],
      "doc": "Lifecycle state of this version; null for records without a lifecycle (e.g. availability bins).",
      "default": null,
      "phalanx.basis": "TRANSFER: NAMP job status; ASSUMPTION: A-W0.4-13",
      "phalanx.restricted": false
    },
    {
